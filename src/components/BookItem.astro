---
import { getLocale, useTranslations, plural } from "../i18n/ui";
import { type Book, bookUrl, publishedCount, progressPercent } from "../data/books";
import BookCover from "./BookCover.astro";

interface Props {
  book: Book;
  solo?: boolean;
  index?: number;
}

const { book, solo = false, index = 0 } = Astro.props;
const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);
const published = publishedCount(book);
const total = book.chapters.length;
const toCome = total - published;
const unit = (n: number) => plural(n, t("unit.chapter.one"), t("unit.chapter.other"));
const gaugeColor = book.color === "apricot" ? "var(--gauge-apricot)" : "var(--gauge-rose)";
---

<article class:list={["item", { solo }]} style={`--i: ${index}`}>
  <div class="cover-slot">
    {book.forthcoming ? (
      <BookCover book={book} />
    ) : (
      <a class="cover-link" href={bookUrl(locale, book)}><BookCover book={book} /></a>
    )}
  </div>
  <div class="details">
    {solo && book.description && <p class="description">{book.description[locale]}</p>}
    {book.living && (
      <div class="living">
        <span class="living-title">{t("book.living")}</span>
        <span class="mono">
          {published > 0 ? `${published} ${unit(published)}` : `${toCome} ${unit(toCome)} ${t("unit.toCome")}`}
        </span>
      </div>
    )}
    {book.gauge && (
      <div class="gauge">
        <div class="rail"><div class="fill" style={`width: ${progressPercent(book)}%; background: ${gaugeColor}`}></div></div>
        <div class="gauge-label mono">
          <span>{published}/{total} {unit(total)}</span>
          <span class="percent">{progressPercent(book)} %</span>
        </div>
      </div>
    )}
    {book.forthcoming && (
      <div class="gauge">
        <div class="rail"></div>
        <div class="gauge-label mono"><span>{t("book.forthcoming")}</span></div>
      </div>
    )}
  </div>
</article>

<style>
  .item.solo {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-columns: subgrid;
    column-gap: 18px;
    align-items: start;
  }
  .solo .details { grid-column: 2 / -1; }
  .cover-link { display: block; text-decoration: none; }
  .item:not(.solo) .details { margin-top: 16px; }
  .description { margin: 0 0 16px; font-size: 15px; line-height: 1.55; color: var(--ink-soft); }
  .mono { font-family: var(--font-mono); font-size: 13px; color: var(--ink-muted); }
  .living { padding-top: 12px; border-top: 1px solid var(--line); }
  .living-title { display: block; font-family: var(--font-serif); font-style: italic; font-size: 22px; line-height: 1.1; color: var(--accent-text); }
  .living .mono { display: block; margin-top: 4px; }
  .rail { height: 6px; border-radius: 3px; background: var(--rule); overflow: hidden; }
  .fill { height: 6px; border-radius: 3px; }
  .gauge-label { display: flex; flex-wrap: wrap; justify-content: space-between; column-gap: 8px; margin-top: 8px; }
  .gauge-label span { white-space: nowrap; }
  .percent { color: var(--ink); }

  /* Living shelf. The cover lifts when hovered or focused, like a book
     pulled from the shelf. */
  .cover-link :global(.cover) { transition: transform .25s ease, box-shadow .25s ease; }
  .cover-link:hover :global(.cover),
  .cover-link:focus-visible :global(.cover) {
    transform: translateY(-6px) rotate(-1deg);
    box-shadow: 8px 10px 0 var(--shadow);
  }
  /* The details arrive one book after the other (--i = position on the shelf),
     and the gauge fills up from the left. The covers themselves do not
     animate in: they are the ones that glide between pages. */
  .details { animation: shelf-in .5s ease both; animation-delay: calc(var(--i) * 80ms + .1s); }
  .fill { transform-origin: 0 50%; animation: gauge 1s cubic-bezier(.2, .7, .2, 1) both; animation-delay: calc(var(--i) * 80ms + .35s); }
  @keyframes shelf-in { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
  @keyframes gauge { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  @media (prefers-reduced-motion: reduce) {
    .cover-link :global(.cover), .details, .fill { animation: none; transition: none; }
    .cover-link:hover :global(.cover), .cover-link:focus-visible :global(.cover) { transform: none; }
  }
</style>

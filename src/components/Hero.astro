---
import { getLocale, useTranslations, plural } from "../i18n/ui";
import { stats } from "../data/books";

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);
const n = stats.publishedChapters;
const kicker = `${t("hero.kicker")} · ${n} ${plural(n, t("stats.chapters.one"), t("stats.chapters.other"))}`;
---

<section class="hero">
  <p class="kicker">
    <span class="dot" aria-hidden="true"></span>
    {kicker}
  </p>

  <h1>Building<br />AI agents<br /><em>in public…</em></h1>

  <p class="subtitle" set:html={t("hero.subtitle")} />

  <div class="actions">
    <a class="cta" href={`/${locale}/shelf/`}>
      {t("hero.cta")}
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
        stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M5 12h14M13 6l6 6-6 6"></path>
      </svg>
    </a>
    <a class="secondary" href={`/${locale}/baa-101/`}>{t("hero.baa")}</a>
  </div>
</section>

<style>
  .hero { padding: 44px 24px 0; text-align: center; }
  .kicker {
    display: inline-flex; align-items: center; gap: 10px; margin: 0;
    font-family: var(--font-mono); font-size: 12px; letter-spacing: 2px;
    text-transform: uppercase; color: var(--ink-muted);
  }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--book-rose); }
  h1 {
    margin: 22px 0 0; font-family: var(--font-serif); font-weight: 400;
    font-size: 62px; line-height: 0.94; letter-spacing: -1.5px;
  }
  .subtitle { max-width: 34ch; margin: 22px auto 0; font-size: 17px; line-height: 1.6; color: var(--ink-soft); }
  .subtitle :global(strong) { color: var(--ink); font-weight: 600; }
  .actions { display: flex; flex-direction: column; align-items: center; gap: 14px; margin-top: 30px; }
  .cta {
    display: inline-flex; align-items: center; justify-content: center; gap: 10px;
    width: 250px; min-height: 54px; border-radius: 999px;
    background: var(--accent); color: var(--on-accent); box-shadow: 5px 5px 0 var(--shadow);
    font-size: 16px; font-weight: 600; text-decoration: none;
  }
  .cta:hover { background: var(--accent-hover); }
  .secondary {
    display: inline-flex; align-items: center; min-height: 44px;
    font-size: 15px; font-weight: 500; text-underline-offset: 4px;
  }
</style>

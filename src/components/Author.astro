---
import { Image } from "astro:assets";
import { getLocale, useTranslations } from "../i18n/ui";
import portrait from "../assets/mialy.jpg";
const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);
---

<section class="author">
  <div class="row">
    <div class="arch">
      <Image class="photo" src={portrait} alt={t("author.photoAlt")} widths={[140, 280, 420]} sizes="140px" />
    </div>
    <div>
      <p class="kicker">{t("author.kicker")}</p>
      <p class="line" set:html={t("author.line")} />
      <p class="signature">— Mialy</p>
    </div>
  </div>
  <div class="foot">
    <a href={`/${locale}/about/`}>{t("author.about")}</a>
  </div>
</section>

<style>
  .author { padding: 52px 24px 0; }
  .row { display: flex; gap: 20px; align-items: flex-end; }
  .arch {
    position: relative;
    flex-shrink: 0;
    width: 140px;
    height: 175px;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 999px 999px 14px 14px;
    background: var(--blush);
    box-shadow: 5px 5px 0 var(--shadow);
  }
  /* The photo fills the arch (cropped to 4:5, face kept in view), slightly
     softened to sit in the paper-and-plum palette: a touch less saturation,
     and a plum veil blended in "soft light" on top. */
  .arch :global(.photo) {
    display: block; width: 100%; height: 100%;
    object-fit: cover; object-position: 50% 25%;
    filter: saturate(0.85) contrast(0.97);
  }
  .arch::after {
    content: ""; position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(180deg, rgba(243, 196, 166, 0.35), rgba(122, 46, 92, 0.35));
    mix-blend-mode: soft-light;
  }
  .kicker {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  .line {
    margin: 8px 0 0;
    font-family: var(--font-serif);
    font-size: 23px;
    line-height: 1.15;
  }
  .signature {
    margin: 8px 0 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 24px;
    color: var(--accent-text);
  }
  .foot { display: flex; justify-content: flex-end; align-items: center; margin-top: 16px; }
  .foot a { display: inline-flex; align-items: center; min-height: 44px; font-size: 15px; font-weight: 500; }
</style>

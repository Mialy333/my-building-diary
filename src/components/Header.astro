---
import { locales, getLocale, useTranslations } from "../i18n/ui";

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);

const pathFor = (target: string) =>
  Astro.url.pathname.replace(/^\/(en|fr)(?=\/|$)/, `/${target}`);

const shelfHref = `/${locale}/shelf/`;
const onShelf = Astro.url.pathname.replace(/\/?$/, "/") === shelfHref;
---

<header class="site-header">
  <a class="brand" href={`/${locale}/`}>
    <span class="ribbon" aria-hidden="true"></span>
    <span class="brand-name">My Building <em>Library</em></span>
  </a>

  <div class="right">
    <nav aria-label={t("nav.label")}>
      <a class="nav-link" href={shelfHref} aria-current={onShelf ? "page" : undefined}>{t("nav.shelf")}</a>
    </nav>

    <nav class="lang" aria-label={t("lang.label")}>
      {locales.map((l, i) => (
        <>
          {i > 0 && <span class="sep" aria-hidden="true">/</span>}
          {l === locale ? (
            <span class="current" aria-current="true">{l.toUpperCase()}</span>
          ) : (
            <a href={pathFor(l)} hreflang={l} lang={l} aria-label={t(`lang.${l}`)}>
              {l.toUpperCase()}
            </a>
          )}
        </>
      ))}
    </nav>

    <button class="theme" type="button" data-theme-toggle aria-label={t("theme.toggle")} title={t("theme.toggle")}>
      <svg class="theme-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
        stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"></path>
      </svg>
      <svg class="theme-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
        stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
      </svg>
    </button>
  </div>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
  button?.addEventListener("click", () => {
    const root = document.documentElement;
    const systemDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
    const current = root.dataset.theme ?? (systemDark ? "dark" : "light");
    const next = current === "dark" ? "light" : "dark";
    root.dataset.theme = next;
    try {
      localStorage.setItem("theme", next);
    } catch {}
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--paper);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 4px;
    height: 64px;
    padding: 0 4px 0 16px;
    border-bottom: 1px solid var(--line);
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    color: var(--ink);
    text-decoration: none;
    flex-shrink: 0;
  }
  .ribbon {
    width: 10px;
    height: 16px;
    background: var(--accent);
    clip-path: polygon(0 0, 100% 0, 100% 100%, 50% 75%, 0 100%);
  }
  .brand-name { font-family: var(--font-serif); font-size: 20px; line-height: 1; }
  .right { display: flex; align-items: center; gap: 0; }
  .nav-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 8px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--ink);
    text-decoration: none;
  }
  .nav-link:hover { color: var(--accent-text); }
  .nav-link[aria-current="page"] { color: var(--accent-text); text-decoration: underline; text-underline-offset: 5px; }
  .lang {
    display: flex;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 1px;
  }
  .lang a, .lang .current {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 30px;
    min-height: 44px;
  }
  .lang .current { color: var(--ink); }
  .lang a { color: var(--ink-muted); text-decoration: none; }
  .lang a:hover { color: var(--accent-text); }
  .sep { color: var(--ink-faint); }
  .theme {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: none;
    color: var(--ink);
    cursor: pointer;
  }
  .theme:hover { color: var(--accent-text); }
  /* Small phones (under 380 px): "Library" is longer than "Diary", so the
     shelf link gives back a little padding to keep everything on one line. */
  @media (max-width: 379px) {
    .nav-link { padding: 0 4px; }
    .brand { gap: 8px; }
  }
</style>

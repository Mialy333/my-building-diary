---
// Full-screen illustrated scene for the home page: sky on top, the hero text
// in the middle (passed in through the slot), the city and the desk at the bottom.
// Pure SVG + CSS, no JavaScript, no dependency. Day/night follows the site theme.
import { getLocale, useTranslations } from "../i18n/ui";

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);
---

<section class="scene">
  <div class="sky" aria-hidden="true">
    <svg viewBox="0 0 390 300">
      <g class="night stars">
        <circle class="twinkle" cx="40" cy="92" r="1.4" style="--d:3.2s"></circle>
        <circle class="twinkle" cx="92" cy="148" r="1.1" style="--d:2.6s;--w:.8s"></circle>
        <circle class="twinkle" cx="24" cy="204" r="1.3" style="--d:4s;--w:.3s"></circle>
        <circle class="twinkle" cx="206" cy="88" r="1.2" style="--d:3s;--w:1.4s"></circle>
        <circle class="twinkle" cx="366" cy="150" r="1.4" style="--d:3.6s;--w:.6s"></circle>
        <circle class="twinkle" cx="300" cy="236" r="1" style="--d:2.8s;--w:1.9s"></circle>
        <circle class="twinkle" cx="62" cy="268" r="1.1" style="--d:3.4s;--w:1.1s"></circle>
        <circle class="twinkle" cx="350" cy="280" r="1.2" style="--d:3.8s;--w:.4s"></circle>
      </g>

      <!-- Clouds stay in the side margins: a decoration never crosses a title. -->
      <g class="clouds">
        <ellipse cx="22" cy="176" rx="24" ry="7"></ellipse>
        <ellipse cx="38" cy="170" rx="14" ry="6"></ellipse>
        <ellipse cx="370" cy="236" rx="24" ry="7"></ellipse>
        <ellipse cx="354" cy="230" rx="14" ry="6"></ellipse>
      </g>

      <path class="wire" d="M-10 18 Q195 70 400 18"></path>
      <g class="night halos">
        <circle cx="31" cy="27" r="8"></circle>
        <circle cx="195" cy="44" r="8"></circle>
        <circle cx="359" cy="27" r="8"></circle>
      </g>
      <g class="bulbs">
        <circle class="twinkle" cx="31" cy="27" r="3.4" style="--d:2.4s"></circle>
        <circle class="twinkle" cx="72" cy="35" r="3.4" style="--d:2.4s;--w:.3s"></circle>
        <circle class="twinkle" cx="113" cy="40" r="3.4" style="--d:2.4s;--w:.6s"></circle>
        <circle class="twinkle" cx="154" cy="43" r="3.4" style="--d:2.4s;--w:.9s"></circle>
        <circle class="twinkle" cx="195" cy="44" r="3.4" style="--d:2.4s;--w:1.2s"></circle>
        <circle class="twinkle" cx="236" cy="43" r="3.4" style="--d:2.4s;--w:1.5s"></circle>
        <circle class="twinkle" cx="277" cy="40" r="3.4" style="--d:2.4s;--w:1.8s"></circle>
        <circle class="twinkle" cx="318" cy="35" r="3.4" style="--d:2.4s;--w:2.1s"></circle>
        <circle class="twinkle" cx="359" cy="27" r="3.4" style="--d:2.4s;--w:.15s"></circle>
      </g>
    </svg>
  </div>

  <div class="copy">
    <slot />
  </div>

  <div class="ground" role="img" aria-label={t("scene.label")}>
    <svg class="orb-svg" viewBox="0 0 48 48" aria-hidden="true">
      <circle class="orb" cx="24" cy="24" r="20"></circle>
      <circle class="night crescent" cx="31" cy="18" r="17"></circle>
    </svg>

    <svg class="city" width="100%" height="100" aria-hidden="true">
      <defs>
        <pattern id="desk-city" width="390" height="100" patternUnits="userSpaceOnUse">
          <g class="buildings">
            <rect x="0" y="40" width="40" height="60"></rect>
            <rect x="40" y="20" width="30" height="80"></rect>
            <rect x="70" y="0" width="46" height="100"></rect>
            <rect x="116" y="30" width="28" height="70"></rect>
            <rect x="144" y="0" width="40" height="100"></rect>
            <rect x="184" y="15" width="34" height="85"></rect>
            <rect x="218" y="0" width="44" height="100"></rect>
            <rect x="262" y="25" width="30" height="75"></rect>
            <rect x="292" y="5" width="50" height="95"></rect>
            <rect x="342" y="35" width="48" height="65"></rect>
          </g>
          <g class="night windows">
            <rect class="twinkle" x="80" y="6" width="5" height="6" style="--d:6s"></rect>
            <rect x="96" y="26" width="5" height="6"></rect>
            <rect class="twinkle" x="154" y="4" width="5" height="6" style="--d:7s;--w:2s"></rect>
            <rect x="168" y="20" width="5" height="6"></rect>
            <rect class="twinkle" x="228" y="4" width="5" height="6" style="--d:5s;--w:1s"></rect>
            <rect x="244" y="40" width="5" height="6"></rect>
            <rect x="302" y="18" width="5" height="6"></rect>
            <rect class="twinkle" x="318" y="36" width="5" height="6" style="--d:8s;--w:3s"></rect>
            <rect x="360" y="50" width="5" height="6"></rect>
          </g>
        </pattern>
      </defs>
      <rect width="100%" height="100" fill="url(#desk-city)"></rect>
    </svg>

    <div class="desk"></div>

    <svg class="objects" viewBox="0 200 342 130" aria-hidden="true">
      <g class="computer">
        <rect class="monitor" x="64" y="294" width="48" height="8" rx="2" stroke-width="1"></rect>
        <rect class="monitor" x="24" y="204" width="128" height="94" rx="12" stroke-width="1.2"></rect>
        <rect class="screen" x="36" y="214" width="104" height="64" rx="7"></rect>
        <g class="code">
          <text class="type" x="44" y="234">&gt; retrieve</text>
          <text class="type" x="44" y="250" style="--w:1s">&gt; cite | refuse</text>
          <text class="type" x="44" y="266" style="--w:2s">&gt; trace</text>
        </g>
        <rect class="cursor" x="84" y="259" width="6" height="9"></rect>
        <circle class="power" cx="132" cy="288" r="2"></circle>
      </g>

      <g transform="translate(-8 0)">
        <path class="leaf sway" d="M200 272 C186 258 188 240 196 232 C202 246 204 258 200 272 Z" style="--d:5s"></path>
        <path class="leaf dark sway" d="M202 272 C210 252 222 246 232 248 C226 260 216 268 202 272 Z" style="--d:6s;--w:.7s"></path>
        <path class="leaf sway" d="M199 272 C188 264 176 264 170 270 C180 276 190 276 199 272 Z" style="--d:5.5s;--w:1.3s"></path>
        <path class="pot" d="M186 272 h30 l-4 28 h-22 z"></path>
      </g>

      <g transform="translate(-24 0)">
        <path class="steam" d="M268 270 q-4 -6 0 -12 q4 -6 0 -12"></path>
        <path class="steam" d="M277 268 q-4 -6 0 -12 q4 -6 0 -12" style="--w:1.1s"></path>
        <path class="handle" d="M290 282 q10 0 10 7 q0 7 -10 7"></path>
        <rect class="mug" x="262" y="276" width="28" height="24" rx="5"></rect>
      </g>

      <g transform="translate(-30 0)">
        <path class="tail" d="M332 296 C346 298 346 316 337 326"></path>
        <path class="fur" d="M308 301 C305 285 310 271 321 269 C332 271 337 285 334 301 Z"></path>
        <path class="fur" d="M310 256 L312 243 L320 251 Z"></path>
        <path class="fur" d="M322 251 L330 243 L332 256 Z"></path>
        <circle class="fur" cx="321" cy="259" r="11"></circle>
        <path class="pink" d="M312.5 253 L313.5 247 L317 251 Z" opacity=".7"></path>
        <path class="pink" d="M325 251 L328.5 247 L329.5 253 Z" opacity=".7"></path>
        <ellipse class="eye" cx="317" cy="258" rx="1.7" ry="2.1"></ellipse>
        <ellipse class="eye" cx="325" cy="258" rx="1.7" ry="2.1"></ellipse>
        <path class="pink" d="M319.8 262.5 h2.4 l-1.2 1.4 z"></path>
      </g>
    </svg>
  </div>
</section>

<style>
  /* Day palette: scene-only colours, on top of the site tokens. */
  .scene {
    --night: 0;
    --sky-mid: #EDB5AE; --orb: #FBE3B8; --cloud: #FFF3EA; --cloud-opacity: .85;
    --city: #D59AA8; --wire: #9C6B7E; --bulb: #F6D58E;
    --desk-top: #E3C2B4; --desk-front: #EAD3C8; --monitor: #F1E6DA;
    --leaf: #8FB394; --leaf-dark: #6F9A78; --mug: #F4DDE2;
    --fur: #4A3F47; --eye: #F6D58E;
    --desk-h: 56px;     /* height of the desk band at the bottom */
    --obj-w: 342px;     /* width of the desk objects drawing */
  }
  /* Night palette: same two selectors as global.css, so the scene follows
     both the system preference and the theme button. */
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .scene {
      --night: 1;
      --sky-mid: #3E2744; --orb: #F4E6C8; --cloud: #6B4A68; --cloud-opacity: .5;
      --city: #2E2030; --wire: #6B4A62; --bulb: #FFD98A;
      --desk-top: #3A2A35; --desk-front: #2D2129; --monitor: #CBBFB3;
      --leaf: #6F9A78; --leaf-dark: #557D5E; --mug: #7A2E5C;
      --fur: #120D11; --eye: #F2C46D;
    }
  }
  :global(:root[data-theme="dark"]) .scene {
    --night: 1;
    --sky-mid: #3E2744; --orb: #F4E6C8; --cloud: #6B4A68; --cloud-opacity: .5;
    --city: #2E2030; --wire: #6B4A62; --bulb: #FFD98A;
    --desk-top: #3A2A35; --desk-front: #2D2129; --monitor: #CBBFB3;
    --leaf: #6F9A78; --leaf-dark: #557D5E; --mug: #7A2E5C;
    --fur: #120D11; --eye: #F2C46D;
  }
  @media (min-width: 640px) {
    .scene { --obj-w: 400px; --desk-h: 64px; }
  }

  /* Layout: the scene fills the first screen under the 64px header.
     svh = the visible height on phones, without the browser bars. */
  .scene {
    position: relative; overflow: hidden;
    display: flex; flex-direction: column;
    min-height: calc(100svh - 64px);
    background: linear-gradient(#F3C4A6, #E8A7B6);
  }
  /* The night sky is a second gradient laid on top: a gradient cannot fade
     into another one, but an opacity can. */
  .scene::before {
    content: ""; position: absolute; inset: 0;
    background: linear-gradient(#1C1424, #4A2E4F);
    opacity: var(--night); transition: opacity .8s;
  }

  .sky {
    position: absolute; top: 0; left: 50%; transform: translateX(-50%);
    width: min(100%, 720px);
  }
  .sky svg { display: block; width: 100%; height: auto; }

  /* The text starts just below the garland, which grows with the screen. */
  .copy { position: relative; padding-top: clamp(64px, 12vw, 96px); }

  .ground { position: relative; margin-top: auto; }
  /* Sun by day, moon by night: low on the right, just above the cat. */
  .orb-svg { position: absolute; top: -56px; right: max(16px, 10%); width: 48px; }
  .city { display: block; }
  .desk { height: var(--desk-h); background: var(--desk-front); border-top: 12px solid var(--desk-top); transition: background .8s, border-color .8s; }
  /* The objects drawing has its desk line 30 units above its bottom edge
     (on a 342-unit width). This puts that line exactly on the desk band. */
  .objects {
    position: absolute; left: 50%; transform: translateX(-50%);
    width: var(--obj-w); bottom: calc(var(--desk-h) - var(--obj-w) * 30 / 342);
  }

  /* Colours come from CSS, so the theme switch can fade them. */
  .night { opacity: var(--night); transition: opacity .8s; }
  .stars { fill: #F7EBD0; }
  .orb { fill: var(--orb); transition: fill .8s; }
  .crescent { fill: var(--sky-mid); }
  .clouds { fill: var(--cloud); opacity: var(--cloud-opacity); transition: opacity .8s; animation: drift 26s ease-in-out infinite alternate; }
  .buildings { fill: var(--city); transition: fill .8s; }
  .windows { fill: #F2C46D; }
  .wire { fill: none; stroke: var(--wire); stroke-width: 1; }
  .halos { fill: #FFD98A; opacity: calc(var(--night) * .22); }
  .bulbs { fill: var(--bulb); }
  .monitor { fill: var(--monitor); stroke: var(--ink); }
  .screen { fill: #241A26; }
  .code { font-family: var(--font-mono), monospace; font-size: 9px; fill: #F4B6CF; }
  .cursor { fill: #F4B6CF; animation: blink 1s steps(1) infinite; }
  .power { fill: #7A2E5C; }
  .leaf { fill: var(--leaf); }
  .leaf.dark { fill: var(--leaf-dark); }
  .pot { fill: #C77E6B; stroke: var(--ink); stroke-width: 1; }
  .steam { fill: none; stroke: var(--ink-muted); stroke-width: 1.4; stroke-linecap: round; }
  .handle { fill: none; stroke: var(--ink); stroke-width: 1.4; }
  .mug { fill: var(--mug); stroke: var(--ink); stroke-width: 1.2; transition: fill .8s; }
  .fur { fill: var(--fur); transition: fill .8s; }
  .tail { fill: none; stroke: var(--fur); stroke-width: 5; stroke-linecap: round; }
  .pink { fill: #E3A0AA; }
  .eye { fill: var(--eye); }

  /* Motion. --d = duration, --w = delay (wait), set per element in the markup. */
  .twinkle { animation: twinkle var(--d, 3s) ease-in-out var(--w, 0s) infinite; }
  .type { opacity: 0; animation: type-line 7s steps(1) var(--w, 0s) infinite; }
  .sway { transform-box: fill-box; transform-origin: 50% 100%; animation: sway var(--d, 5s) ease-in-out var(--w, 0s) infinite; }
  .steam { transform-box: fill-box; animation: steam 3.2s ease-out var(--w, 0s) infinite; }
  .tail { transform-box: fill-box; transform-origin: 0 0; animation: tail 4s ease-in-out infinite; }
  .eye { transform-box: fill-box; transform-origin: 50% 50%; animation: cat-blink 5s ease-in-out infinite; }

  @keyframes drift { from { transform: translateX(-12px); } to { transform: translateX(12px); } }
  @keyframes twinkle { 0%, 100% { opacity: .35; } 50% { opacity: 1; } }
  @keyframes type-line { 0%, 8% { opacity: 0; } 16%, 88% { opacity: 1; } 100% { opacity: 0; } }
  @keyframes blink { 50% { opacity: 0; } }
  @keyframes sway { 0%, 100% { transform: rotate(-4deg); } 50% { transform: rotate(4deg); } }
  @keyframes steam { 0% { opacity: 0; transform: translateY(6px); } 40% { opacity: .75; } 100% { opacity: 0; transform: translateY(-16px); } }
  @keyframes tail { 0%, 100% { transform: rotate(0deg); } 50% { transform: rotate(14deg); } }
  @keyframes cat-blink { 0%, 90%, 100% { transform: scaleY(1); } 94% { transform: scaleY(.1); } }

  /* Reduced motion: a still picture, with the code lines visible. */
  @media (prefers-reduced-motion: reduce) {
    .scene *, .scene::before { animation: none !important; transition: none !important; }
    .type { opacity: 1; }
  }
</style>

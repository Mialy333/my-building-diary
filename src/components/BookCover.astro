---
import { getLocale, useTranslations } from "../i18n/ui";
import { type Book, bookNumber, isInProgress } from "../data/books";

interface Props {
  book: Book;
  size?: "shelf" | "page";
}

const { book, size = "shelf" } = Astro.props;
const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);
const cover = book.cover;
const Title = size === "page" ? "p" : "h3";
---

<div class:list={["cover", size, { forthcoming: book.forthcoming }]}>
  {isInProgress(book) && (
    <>
      <span class="ribbon" aria-hidden="true"></span>
      <span class="sr-only">{t("book.inProgress")}</span>
    </>
  )}
  <div class="meta">
    <span>BOOK {bookNumber(book)}</span>
    {cover.info[locale] && <span>{cover.info[locale]}</span>}
  </div>
  <Title class="title">{cover.title[locale]}<em>{cover.accent[locale]}</em></Title>
  {cover.subtitle[locale] && <p class="subtitle">{cover.subtitle[locale]}</p>}
  {book.forthcoming ? (
    <span class="stamp">{t("book.stamp")}</span>
  ) : (
    <div class="screen" style={`background: var(--book-${book.color})`} aria-hidden="true">
      {cover.bars.map((h) => <span class="bar" style={`height: ${h}%`}></span>)}
    </div>
  )}
</div>

<style>
  .cover {
    position: relative; display: flex; flex-direction: column; aspect-ratio: 2 / 3;
    padding: 12px 12px 12px 16px;
    background: linear-gradient(90deg, var(--rule) 0 4px, transparent 4px), var(--card);
    border: 1px solid var(--ink); border-radius: 3px 10px 10px 3px;
    box-shadow: 5px 5px 0 var(--shadow); color: var(--ink);
  }
  .cover.page { width: 220px; padding: 14px 14px 14px 20px; border-radius: 3px 12px 12px 3px; box-shadow: 6px 6px 0 var(--shadow); }
  .ribbon {
    position: absolute; right: 14px; top: -1px; width: 14px; height: 34px; background: var(--accent);
    clip-path: polygon(0 0, 100% 0, 100% 100%, 50% 78%, 0 100%);
  }
  .page .ribbon { width: 18px; height: 46px; right: 18px; }
  .meta {
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: 2px 8px; padding-right: 24px;
    font-family: var(--font-mono); font-size: 12px; letter-spacing: 1px; color: var(--ink-muted);
  }
  .meta span { white-space: nowrap; }
  .title { margin: 14px 0 0; font-family: var(--font-serif); font-weight: 400; font-size: 32px; line-height: 0.95; }
  .page .title { margin-top: 18px; font-size: 46px; line-height: 0.9; }
  .subtitle { margin: 6px 0 0; font-size: 12px; color: var(--ink-soft); }
  .page .subtitle { font-size: 13px; margin-top: 8px; }
  .screen { display: flex; align-items: flex-end; gap: 6px; height: 64px; margin-top: auto; padding: 10px 12px; border-radius: 8px; }
  .page .screen { height: 100px; gap: 8px; padding: 12px 14px; border-radius: 10px; }
  .bar { width: 12px; border-radius: 3px 3px 0 0; background: rgba(35, 26, 34, 0.75); }
  .page .bar { width: 16px; }
  .forthcoming {
    border-style: dashed; border-color: var(--ink-faint); box-shadow: none;
    background: repeating-linear-gradient(135deg, var(--rule) 0 1px, transparent 1px 10px);
  }
  .forthcoming .title { color: var(--ink-muted); }
  .stamp {
    position: absolute; left: 50%; top: 58%; transform: translateX(-50%) rotate(-8deg);
    padding: 6px 14px; border: 1.5px solid var(--accent-text); border-radius: 999px;
    background: var(--paper); color: var(--accent-text);
    font-family: var(--font-mono); font-size: 12px; font-weight: 500; letter-spacing: 2px;
    text-transform: uppercase; white-space: nowrap;
  }
</style>

---
// Site footer: profiles first, then the signature and the secondary pages.
import { getLocale, useTranslations } from "../i18n/ui";
import SocialLinks from "./SocialLinks.astro";
const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);
---

<footer class="site-footer">
  <p class="find">{t("social.find")}</p>
  <SocialLinks />
  <div class="bottom">
    <span>@ellebuild · 2026</span>
    <nav aria-label={t("footer.label")}>
      <a href={`/${locale}/about/`}>{t("footer.about")}</a>
      <span aria-hidden="true">·</span>
      <a href={`/${locale}/blog/`}>{t("footer.blog")}</a>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    max-width: var(--page-max); margin: 64px auto 0; padding: 24px 24px 24px;
    border-top: 1px solid var(--line);
  }
  .find {
    margin: 0 0 12px; font-family: var(--font-serif); font-style: italic; font-size: 22px; line-height: 1.1;
    color: var(--accent-text);
  }
  .bottom {
    display: flex; justify-content: space-between; align-items: center; margin-top: 16px;
    font-family: var(--font-mono); font-size: 13px; letter-spacing: 1px; text-transform: uppercase; color: var(--ink-muted);
  }
  nav { display: flex; align-items: center; gap: 4px; }
  nav a {
    display: inline-flex; align-items: center; min-height: 44px; padding: 0 4px;
    color: var(--ink-muted); text-decoration: none;
  }
  nav a:hover { color: var(--accent-text); }
</style>

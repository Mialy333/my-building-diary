---
// A page that exists but is not written yet (About, Blog). Rule of the site:
// what is not written is shown as "coming soon", never hidden, and a link
// never leads to a 404.
import { getLocale, useTranslations } from "../i18n/ui";

interface Props {
  heading: string; // HTML, with the accent word in <em>
}

const { heading } = Astro.props;
const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);
---

<section class="soon">
  <p class="kicker">{t("soon.kicker")}</p>
  <h1 set:html={heading} />
  <p class="stamp">{t("book.stamp")}</p>
  <p class="text">{t("soon.text")}</p>
  <a class="cta" href={`/${locale}/shelf/`}>{t("hero.cta")} →</a>
</section>

<style>
  .soon { padding: 56px 24px 0; text-align: center; }
  .kicker {
    margin: 0; font-family: var(--font-mono); font-size: 12px; letter-spacing: 2px;
    text-transform: uppercase; color: var(--ink-muted);
  }
  h1 { margin: 18px 0 0; font-family: var(--font-serif); font-weight: 400; font-size: 62px; line-height: 0.94; letter-spacing: -1.5px; }
  /* Same stamp as the "coming soon" covers. */
  .stamp {
    display: inline-block; margin: 28px 0 0; padding: 6px 14px;
    border: 1.5px solid var(--accent-text); border-radius: 999px; transform: rotate(-8deg);
    color: var(--accent-text); font-family: var(--font-mono); font-size: 12px; font-weight: 500;
    letter-spacing: 2px; text-transform: uppercase;
  }
  .text { max-width: 32ch; margin: 28px auto 0; font-size: 17px; line-height: 1.6; color: var(--ink-soft); }
  .cta {
    display: inline-flex; align-items: center; justify-content: center; min-height: 54px; margin-top: 28px;
    padding: 0 32px; border-radius: 999px; background: var(--accent); color: var(--on-accent);
    box-shadow: 5px 5px 0 var(--shadow); font-weight: 600; text-decoration: none;
  }
  .cta:hover { background: var(--accent-hover); }
</style>

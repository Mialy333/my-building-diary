---
// Section title above the stats: a rounded arc with "My activities" in the
// middle. A small plum dot travels along the arc, from right to left.
import { getLocale, useTranslations } from "../i18n/ui";
const t = useTranslations(getLocale(Astro.currentLocale));
---

<section class="loop">
  <div class="arc">
    <i class="runner" aria-hidden="true"></i>
    <h2>{t("loop.title")}</h2>
  </div>
</section>

<style>
  .loop { padding: 40px 28px 0; }
  .arc { position: relative; height: 32px; margin: 0 14px; }
  .arc::before {
    content: "";
    position: absolute;
    left: 0; right: 0; top: 14px;
    height: 18px;
    border: 1px solid var(--arc, #D9C6CC);
    border-bottom: none;
    border-radius: 14px 14px 0 0;
  }
  /* The title sits on the arc; its paper background hides the line behind it. */
  h2 {
    position: absolute;
    left: 50%; top: 0;
    transform: translateX(-50%);
    margin: 0;
    padding: 0 10px;
    background: var(--paper);
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    font-size: 22px;
    line-height: 1;
    white-space: nowrap;
    color: var(--accent-text);
  }

  /* The dot follows the arc's border: up the right side, along the top
     (behind the title), down the left side. One trip every 6 s. */
  .runner {
    position: absolute; left: 100%; top: 32px; width: 7px; height: 7px;
    border-radius: 50%; background: var(--accent); transform: translate(-50%, -50%);
    opacity: 0; animation: arc-run 6s linear infinite;
  }
  @keyframes arc-run {
    0% { left: 100%; top: 32px; opacity: 0; }
    6% { left: 100%; top: 26px; opacity: 1; }
    14% { left: calc(100% - 4px); top: 17px; }
    20% { left: calc(100% - 14px); top: 14.5px; }
    76% { left: 14px; top: 14.5px; }
    82% { left: 4px; top: 17px; }
    92% { left: 0; top: 26px; opacity: 1; }
    100% { left: 0; top: 32px; opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .runner { animation: none; }
  }
</style>

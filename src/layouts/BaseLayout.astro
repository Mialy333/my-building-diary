---
import { Font } from "astro:assets";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { locales, getLocale, useTranslations } from "../i18n/ui";
import "../styles/global.css";

interface Props {
  title?: string;
}

const { title = "My Building Library" } = Astro.props;

// Link previews and search engines. Astro.site comes from `site` in astro.config.mjs.
const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);
const description = t("hero.subtitle").replace(/<[^>]+>/g, ""); // the subtitle, without its <strong> tags
const canonical = new URL(Astro.url.pathname, Astro.site);
// Same page in the other language: only the /fr/ or /en/ prefix changes (same slugs in both).
const inLocale = (l: string) => new URL(Astro.url.pathname.replace(/^\/(en|fr)(?=\/|$)/, `/${l}`), Astro.site);
---

<html lang={Astro.currentLocale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {locales.map((l) => <link rel="alternate" hreflang={l} href={inLocale(l)} />)}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="My Building Library" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale === "fr" ? "fr_FR" : "en_US"} />
    <meta name="twitter:card" content="summary" />
    <script is:inline>
      try {
        const saved = localStorage.getItem("theme");
        if (saved === "light" || saved === "dark") document.documentElement.dataset.theme = saved;
      } catch {}
    </script>
    <Font cssVariable="--font-serif" preload />
    <Font cssVariable="--font-sans" />
    <Font cssVariable="--font-mono" />
    <Font cssVariable="--font-reading" />
  </head>
  <body>
    <Header />
    <main>
      <slot name="hero" />
      <div class="page">
        <slot />
      </div>
    </main>
    <Footer />
  </body>
</html>
